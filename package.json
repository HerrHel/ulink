{
  "name": "linkvault",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --max-warnings 0",
    "lint:style": "stylelint \"src/styles/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai-eval": "vitest run --config vitest.ai-eval.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test",
    "coverage": "vitest run --coverage",
    "ext:bundle-supabase": "npx esbuild@latest --bundle --format=iife --global-name=supabase --outfile=extension/lib/supabase.js @supabase/supabase-js",
    "ext:pack": "node scripts/pack-extension.js",
    "email:sync": "node scripts/sync-email-template.cjs",
    "pages:dev": "npm run build && npx wrangler@latest pages dev dist --port 8788",
    "pages:deploy": "npm run build && npx wrangler@latest pages deploy dist --project-name ulink",
    "verify": "npm run lint && npm run lint:style && npm run typecheck && npm run test",
    "verify:fast": "npm run lint && npm run typecheck",
    "verify:e2e": "npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks || true",
    "ssl:status": "node scripts/ssl-renew.mjs",
    "dns:list": "node scripts/dnspod-records.mjs list ulink.ren"
  },
  "devDependencies": {
    "@cloudbase/manager-node": "^5.9.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.9.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.28",
    "purgecss": "^8.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.10.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-history": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/qrcode": "^1.5.6",
    "dexie": "^4.4.3",
    "dompurify": "^3.4.13",
    "fuse.js": "^7.4.2",
    "marked": "^18.1.2",
    "nanoid": "^6.0.0",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "zod": "^4.6.7"
  }
}
