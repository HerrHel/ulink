# Supabase 配置（必填）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CloudBase（腾讯云开发）配置 —— 迁移目标环境
# publishable key 用 `tcb env apikey create <name> -e <envId> --type publish_key` 生成，
# 语义等价 anon key（映射 PG 的 anon 角色、受 RLS 约束），可放前端。
VITE_CLOUDBASE_ENV_ID=
VITE_PUBLISHABLE_KEY=
# 后端开关：留空 / supabase = 现有 Supabase 链路（默认）；cloudbase = CloudBase PG 驱动
# VITE_BACKEND=cloudbase

# ── CloudBase 邮件发信（可选）──
# 不填 → 用 CloudBase 平台代发（发件地址固定 cloudbase_noreply@tencent.com）
# 填了 → 走自有 SMTP，发件地址变成你自己的域名（腾讯企业邮示例：smtp.exmail.qq.com / 465 / SSL）
# 注意：这三项是真实凭据，只写进 .env.local（已 gitignore），不要提交
# CLOUDBASE_SMTP_SENDER=noreply@ulink.ren
# CLOUDBASE_SMTP_USER=noreply@ulink.ren
# CLOUDBASE_SMTP_PASS=
# CLOUDBASE_SMTP_HOST=smtp.exmail.qq.com
# CLOUDBASE_SMTP_PORT=465
# CLOUDBASE_SMTP_SECURE=SSL

# Supabase CLI 访问令牌（本地 supabase 命令用，仅本地开发需要）
SUPABASE_ACCESS_TOKEN=

# Edge Function check-link（可选）
# ALLOWED_ORIGINS=https://ulink.ren
# CHECK_LINK_TIMEOUT_MS=10000

# ── L2 真后端 Playwright（可选，默认 CI 不跑）──
# LV_E2E_L2=1
# 会话二选一：
# 1) 从已登录浏览器 DevTools → Application → localStorage → linkvault_auth 整段复制：
# LV_E2E_L2_SESSION_JSON={"access_token":"...","refresh_token":"...","user":{"id":"...","email":"..."}}
# 2) 分字段：
# LV_E2E_L2_ACCESS_TOKEN=
# LV_E2E_L2_REFRESH_TOKEN=
# LV_E2E_L2_USER_ID=
# LV_E2E_L2_EMAIL=

# PWA 更新轮询间隔（毫秒，默认 30 分钟）
# VITE_SW_UPDATE_INTERVAL=600000

# ULink 专属 AI 助手大模型：统一经 Edge Function mimo-chat 服务端转发，
# 密钥只放 Supabase Function secrets（MIMO_API_KEY / MIMO_BASE_URL / MIMO_MODEL /
# MIMO_ALLOWED_MODELS），禁止任何 VITE_ 前缀的前端密钥（无 BYOK、无客户端直连）
