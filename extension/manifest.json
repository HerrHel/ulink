{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "1.2.1",
  "description": "__MSG_ext_description__",
  "default_locale": "zh_CN",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@ulink.ren",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://ulink.ren/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "__MSG_action_default_title__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "action": {
    "default_title": "__MSG_action_default_title__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*", "https://www.iesdouyin.com/*"],
      "js": ["douyin-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "save-to-linkvault": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "__MSG_command_save_description__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
