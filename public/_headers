/*
  # SEC-05: connect-src 含 https: 是有意放宽——客户端死链 checkDirect 需直连任意书签 URL；
  # 主防线是 script-src 'self'。若改死链仅走 Edge 再收窄 connect-src。
  X-Content-Type-Options: nosniff
  # worker-src 'self' blob: 与 vite.config.ts 的 securityHeaders、edge-headers 的 CSP 对齐（blob Worker 心跳）
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; frame-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https: wss://*.supabase.co; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 双入口 HTML——/ = 宣传落地页（index.html），/app = 应用（app.html；
# Cloudflare Pretty URL 映射）。均需 no-cache，部署后首刷即拿新页。
# 注：/index.html 直链会被 308 到 /，规则随路径名一并列出。
/
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8
/index.html
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8
/app
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8
/app.html
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8

# 落地页脚本——返客跳转逻辑常更新，短缓存
/landing.js
  Cache-Control: public, max-age=300
/hero-visual.js
  Cache-Control: public, max-age=300
/manage-visual.js
  Cache-Control: public, max-age=300
/sync-visual.js
  Cache-Control: public, max-age=300
/share-visual.js
  Cache-Control: public, max-age=300

# PWA Service Worker——必须 no-cache，否则浏览器缓存住旧 SW 永不更新
/sw.js
  Cache-Control: no-cache
# 说明（#51）：不存在根路径 /registerSW.js。vite-plugin-pwa 的注册脚本实际是
# 构建期生成的 /assets/virtual_pwa-register-*.js（带内容 hash，随内容变化即换名），
# 已由上方 /assets/* 的 immutable 规则覆盖，无需也不应单列无效规则。
# 注册脚本本身由 hash 保证新鲜度；sw.js 才必须 no-cache（SW 文件名固定、靠字节比对更新）。