/*
  # SEC-05: connect-src 含 https: 是有意放宽——客户端死链 checkDirect 需直连任意书签 URL；
  # 主防线是 script-src 'self'。若改死链仅走 Edge 再收窄 connect-src。
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https: wss://*.supabase.co; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 双入口 HTML——/ = 宣传落地页（index.html），/app = 应用（app.html；
# Cloudflare Pretty URL 映射）。均需 no-cache，部署后首刷即拿新页。
# 注：/index.html 直链会被 308 到 /，规则随路径名一并列出。
/
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8
/index.html
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8
/app
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8
/app.html
  Cache-Control: no-cache
  Content-Type: text/html; charset=utf-8

# 落地页脚本——返客跳转逻辑常更新，短缓存
/landing.js
  Cache-Control: public, max-age=300
/hero-visual.js
  Cache-Control: public, max-age=300

# PWA Service Worker——必须 no-cache，否则浏览器缓存住旧 SW 永不更新
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache